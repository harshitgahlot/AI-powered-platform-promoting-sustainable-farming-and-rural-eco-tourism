# Project configuration
PROJECT_NAME="RuralConnect AI"
API_V1_STR="/api/v1"

# JWT Authentication (Run python -c "import secrets; print(secrets.token_hex(32))" to generate a secure secret)
JWT_SECRET="your-super-secret-jwt-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection — Supabase PostgreSQL
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Supabase Configuration
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Storage Configuration (local, cloudinary, or s3)
STORAGE_PROVIDER="local"
UPLOAD_DIR=""

# Cloudinary Credentials (Optional, if STORAGE_PROVIDER is cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3 Credentials (Optional, if STORAGE_PROVIDER is s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME="us-east-1"
